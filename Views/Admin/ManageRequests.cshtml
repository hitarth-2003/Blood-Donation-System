@model List<BloodDonationSystem.Models.BloodRequest>

@{
    ViewData["Title"] = "Manage Requests";
}


<div class="container py-5">


    <h2 class="text-danger mb-4">
        Manage Blood Requests
    </h2>



    <table class="table table-bordered table-hover shadow">


        <thead class="table-danger">

            <tr>

                <th>ID</th>

                <th>Patient</th>

                <th>Blood Group</th>

                <th>Units</th>

                <th>Hospital</th>

                <th>City</th>

                <th>Priority</th>

                <th>Contact</th>

                <th>Action</th>

                <th>Status</th>


            </tr>

        </thead>



        <tbody>


        @foreach(var request in Model)
        {

            <tr>


                <td>
                    @request.Id
                </td>


                <td>
                    @request.PatientName
                </td>


                <td>
                    @request.BloodGroup
                </td>


                <td>
                     @request.UnitsRequired
                </td>


                <td>
                    @request.HospitalName
                </td>


                <td>
                    @request.City
                </td>


                <td>
                    @request.Priority
                </td>


                <td>
                    @request.ContactNumber
                </td>

                <td>
                    @request.Status
                </td>



                <td>


                    <a asp-controller="Admin"
                       asp-action="ApproveRequest"
                       asp-route-id="@request.Id"
                       class="btn btn-success btn-sm">

                        Approve

                    </a>


                    <a asp-controller="Admin"
                       asp-action="DeleteRequest"
                       asp-route-id="@request.Id"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Delete this request?')">

                        Delete

                    </a>


                </td>


            </tr>

        }


        </tbody>


    </table>



</div>