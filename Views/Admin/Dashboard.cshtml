@model BloodDonationSystem.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}


<div class="container py-5">

    <h1 class="text-danger text-center mb-5">
        Admin Dashboard
    </h1>


    <div class="row">


        <!-- Total Donors -->

        <div class="col-md-3 mb-4">

            <a asp-controller="Admin"
               asp-action="ManageDonors"
               style="text-decoration:none;">

                <div class="card shadow text-center p-4">

                    <h2 class="text-danger">
                        @Model.TotalDonors
                    </h2>

                    <h5>
                        Total Donors
                    </h5>

                </div>

            </a>

        </div>



        <!-- Blood Requests -->

        <div class="col-md-3 mb-4">

            <a asp-controller="Admin"
               asp-action="ManageRequests"
               style="text-decoration:none;">

                <div class="card shadow text-center p-4">

                    <h2 class="text-danger">
                        @Model.TotalRequests
                    </h2>

                    <h5>
                        Blood Requests
                    </h5>

                </div>

            </a>

        </div>



        <!-- Contacts -->

        <div class="col-md-3 mb-4">

            <a asp-controller="Admin"
               asp-action="Contacts"
               style="text-decoration:none;">

                <div class="card shadow text-center p-4">

                    <h2 class="text-danger">
                        @Model.TotalContacts
                    </h2>

                    <h5>
                        Contact Messages
                    </h5>

                </div>

            </a>

        </div>



        <!-- Blood Groups -->

        <div class="col-md-3 mb-4">

            <div class="card shadow text-center p-4">


                <h2 class="text-danger">
                    8
                </h2>

                <h5>
                    Blood Groups
                </h5>


            </div>

        </div>


    </div>



    <hr class="my-5">


    <h3 class="text-danger mb-4">
        Quick Actions
    </h3>


    <div class="row">


        <div class="col-md-4 mb-3">

            <a asp-controller="Admin"
               asp-action="ManageDonors"
               class="btn btn-danger w-100 p-3">

                Manage Donors

            </a>

        </div>


        <div class="col-md-4 mb-3">

            <a asp-controller="Admin"
               asp-action="ManageRequests"
               class="btn btn-dark w-100 p-3">

                Manage Requests

            </a>

        </div>


        <div class="col-md-4 mb-3">

            <a asp-controller="Admin"
               asp-action="Contacts"
               class="btn btn-success w-100 p-3">

                View Messages

            </a>

        </div>


    </div>


</div>