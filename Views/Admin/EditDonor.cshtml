@model BloodDonationSystem.Models.Donor

@{
    ViewData["Title"] = "Edit Donor";
}

<div class="container py-5">

    <div class="card shadow">

        <div class="card-header bg-danger text-white">

            <h3 class="mb-0">Edit Donor</h3>

        </div>

        <div class="card-body">

            <form asp-action="EditDonor" method="post">

                <input asp-for="Id" type="hidden" />

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Age" class="form-label"></label>
                        <input asp-for="Age" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Gender" class="form-label"></label>

                        <select asp-for="Gender" class="form-select">
                            <option value="">Select Gender</option>
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="BloodGroup" class="form-label"></label>

                        <select asp-for="BloodGroup" class="form-select">
                            <option>A+</option>
                            <option>A-</option>
                            <option>B+</option>
                            <option>B-</option>
                            <option>AB+</option>
                            <option>AB-</option>
                            <option>O+</option>
                            <option>O-</option>
                        </select>

                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Mobile" class="form-label"></label>
                        <input asp-for="Mobile" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LastDonationDate" class="form-label"></label>
                        <input asp-for="LastDonationDate" type="date" class="form-control" />
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                    </div>

                </div>

                <button type="submit" class="btn btn-danger">
                    Update Donor
                </button>

                <a asp-action="ManageDonors" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>