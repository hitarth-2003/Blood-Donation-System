@model IEnumerable<BloodDonationSystem.Models.Donor>

@{
    ViewData["Title"] = "Manage Donors";
}

<div class="container py-5">

    <h2 class="text-danger mb-4">
        Manage Donors
    </h2>

    <table class="table table-bordered table-hover shadow">

        <thead class="table-danger">

            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Blood Group</th>
                <th>City</th>
                <th>Mobile</th>
                <th width="180">Action</th>
            </tr>

        </thead>

        <tbody>

        @foreach (var donor in Model)
        {
            <tr>

                <td>@donor.Id</td>

                <td>@donor.FullName</td>

                <td>@donor.BloodGroup</td>

                <td>@donor.City</td>

                <td>@donor.Mobile</td>

                <td>

                    <a asp-controller="Admin"
                       asp-action="EditDonor"
                       asp-route-id="@donor.Id"
                       class="btn btn-warning btn-sm">

                        Edit

                    </a>

                    <a asp-controller="Admin"
                       asp-action="DeleteDonor"
                       asp-route-id="@donor.Id"
                       class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure you want to delete this donor?');">

                        Delete

                    </a>

                </td>

            </tr>
        }

        </tbody>

    </table>

</div>