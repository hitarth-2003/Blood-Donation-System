@model BloodDonationSystem.Models.HomeViewModel

@{
    ViewData["Title"] = "Home";
}
<!-- Hero Section -->

<div class="container py-5">

    <div class="row align-items-center">

        <div class="col-md-6">

            <h1 class="display-4 fw-bold text-danger">
                Donate Blood, Save Lives ❤️
            </h1>

            <p class="lead mt-4">
                Join our blood donation community and help patients find blood quickly during emergencies.
            </p>

            <div class="mt-4">

                <a asp-controller="Donor"
                   asp-action="Register"
                   class="btn btn-danger btn-lg me-2">
                    Become a Donor
                </a>

                <a asp-controller="Blood"
                   asp-action="RequestBlood"
                   class="btn btn-outline-danger btn-lg">
                    Request Blood
                </a>

            </div>

        </div>

        <div class="col-md-6">

            <div class="row">

                <div class="col-6 mb-3">

                    <div class="card shadow text-center p-4">

                        <h1 class="text-danger">
                            @Model.TotalDonors
                        </h1>

                        <h5>
                            Registered Donors
                        </h5>

                    </div>

                </div>

                <div class="col-6 mb-3">

                    <div class="card shadow text-center p-4">

                        <h1 class="text-danger">
                            @Model.TotalRequests
                        </h1>

                        <h5>
                            Blood Requests
                        </h5>

                    </div>

                </div>

                <div class="col-6">

                    <div class="card shadow text-center p-4">

                        <h1 class="text-danger">
                            24×7
                        </h1>

                        <h5>
                            Emergency Support
                        </h5>

                    </div>

                </div>

                <div class="col-6">

                    <div class="card shadow text-center p-4">

                        <h1 class="text-danger">
                            100%
                        </h1>

                        <h5>
                            Free Service
                        </h5>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<hr>
<hr>

<div class="container py-5">

    <h2 class="text-center text-danger fw-bold mb-5">
        Why Choose Our Platform?
    </h2>

    <div class="row">

        <div class="col-md-4 mb-4">

            <div class="card shadow text-center h-100 p-4">

                <i class="fa-solid fa-user-group fa-3x text-danger mb-3"></i>

                <h4>Verified Donors</h4>

                <p>
                    Every registered donor is verified to ensure safe and reliable blood donation.
                </p>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="card shadow text-center h-100 p-4">

                <i class="fa-solid fa-clock fa-3x text-danger mb-3"></i>

                <h4>24×7 Emergency Support</h4>

                <p>
                    Blood requests can be submitted anytime during emergencies.
                </p>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="card shadow text-center h-100 p-4">

                <i class="fa-solid fa-heart-circle-check fa-3x text-danger mb-3"></i>

                <h4>Trusted Platform</h4>

                <p>
                    Connecting blood donors, hospitals and patients through a secure platform.
                </p>

            </div>

        </div>

    </div>

</div>

<hr>

<div class="container py-5">

    <h2 class="text-center text-danger fw-bold mb-5">
        Why Donate Blood?
    </h2>

    <div class="row text-center">

        <div class="col-md-3 mb-4">

            <div class="card shadow p-4 h-100">

                <h2 class="text-danger">3</h2>

                <p>One blood donation can save up to three lives.</p>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow p-4 h-100">

                <h2 class="text-danger">15 Min</h2>

                <p>Blood donation usually takes only 15 minutes.</p>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow p-4 h-100">

                <h2 class="text-danger">18+</h2>

                <p>Healthy adults aged 18 years or above can donate.</p>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow p-4 h-100">

                <h2 class="text-danger">24×7</h2>

                <p>Emergency blood requests are accepted around the clock.</p>

            </div>

        </div>

    </div>

</div>

<hr>

<div class="container py-5">

    <h2 class="text-center text-danger fw-bold mb-5">
        How It Works
    </h2>

    <div class="row text-center">

        <div class="col-md-3 mb-4">

            <div class="card shadow p-4 h-100">

                <h1 class="text-danger">1️⃣</h1>

                <h4>Register</h4>

                <p>Create your donor profile with your details.</p>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow p-4 h-100">

                <h1 class="text-danger">2️⃣</h1>

                <h4>Search</h4>

                <p>Patients search donors by blood group and city.</p>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow p-4 h-100">

                <h1 class="text-danger">3️⃣</h1>

                <h4>Donate</h4>

                <p>Visit the hospital and donate blood safely.</p>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow p-4 h-100">

                <h1 class="text-danger">4️⃣</h1>

                <h4>Save Lives</h4>

                <p>Your donation helps save precious lives.</p>

            </div>

        </div>

    </div>

</div>

<hr>

<div class="container py-5">

    <h2 class="text-center text-danger fw-bold mb-5">
        Frequently Asked Questions
    </h2>

    <div class="accordion" id="faqAccordion">

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button class="accordion-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq1">

                    Who can donate blood?

                </button>

            </h2>

            <div id="faq1" class="accordion-collapse collapse show">

                <div class="accordion-body">

                    Any healthy person aged 18 years or above can donate blood.

                </div>

            </div>

        </div>

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq2">

                    How often can I donate blood?

                </button>

            </h2>

            <div id="faq2" class="accordion-collapse collapse">

                <div class="accordion-body">

                    Generally, every 3 months for whole blood donation.

                </div>

            </div>

        </div>

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button class="accordion-button collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#faq3">

                    Is blood donation safe?

                </button>

            </h2>

            <div id="faq3" class="accordion-collapse collapse">

                <div class="accordion-body">

                    Yes. Sterile disposable equipment is used for every donor.

                </div>

            </div>

        </div>

    </div>

</div>

<hr>

<div class="container py-5">

    <h2 class="text-center text-danger fw-bold mb-5">
        What People Say
    </h2>

    <div class="row">

        <div class="col-md-4 mb-4">

            <div class="card shadow text-center p-4 h-100">

                <h5>Rahul Sharma</h5>

                <p class="text-warning fs-5">★★★★★</p>

                <p>
                    I found blood for my father within 30 minutes.
                    Excellent platform.
                </p>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="card shadow text-center p-4 h-100">

                <h5>Priya Patel</h5>

                <p class="text-warning fs-5">★★★★★</p>

                <p>
                    Donor registration was simple and quick.
                    Happy to be a blood donor.
                </p>

            </div>

        </div>

        <div class="col-md-4 mb-4">

            <div class="card shadow text-center p-4 h-100">

                <h5>City Hospital</h5>

                <p class="text-warning fs-5">★★★★★</p>

                <p>
                    A reliable platform for connecting donors with hospitals during emergencies.
                </p>

            </div>

        </div>

    </div>

</div>