@{
    ViewData["Title"] = "About";
}

<div class="container py-5">

    <div class="row align-items-center">

        <div class="col-lg-6">

            <h1 class="display-4 text-danger fw-bold">
                About Blood Donation System
            </h1>

            <p class="lead mt-4">
                Blood Donation System is a web application developed to connect blood donors
                with people who need blood during emergencies.
            </p>

            <p>
                Our goal is to make blood donation simple, fast, and accessible. Donors can
                register themselves, while patients can request blood through an easy-to-use
                platform.
            </p>

            <p>
                This project is developed as an MCA Web Application Development mini project
                using ASP.NET Core MVC.
            </p>

        </div>

        <div class="col-lg-6 text-center">

            <img src="https://images.unsplash.com/photo-1615461066841-6116e61058f4?w=700"
                 class="img-fluid rounded shadow"
                 alt="Blood Donation">

        </div>

    </div>

</div>

<div class="container mb-5">

    <div class="row">

        <div class="col-md-4">

            <div class="card shadow text-center p-4">

                <h3 class="text-danger">🎯 Mission</h3>

                <p>
                    To encourage voluntary blood donation and provide blood
                    quickly during emergencies.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow text-center p-4">

                <h3 class="text-danger">👁 Vision</h3>

                <p>
                    To build a reliable platform connecting blood donors
                    with patients across cities.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow text-center p-4">

                <h3 class="text-danger">❤️ Our Goal</h3>

                <p>
                    Save lives by making blood available whenever
                    and wherever it is needed.
                </p>

            </div>

        </div>

    </div>

</div>