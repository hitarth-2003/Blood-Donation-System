@{
    ViewData["Title"] = "About";
}

<div class="container py-5">

    <div class="row align-items-center">

        <div class="col-lg-6">

            <h1 class="display-4 fw-bold text-danger">
                About Blood Donation System
            </h1>

            <p class="lead mt-4">
                Blood Donation System is an ASP.NET Core MVC web application that connects blood donors with patients in need. Our platform makes blood donation simple, quick, and reliable.
            </p>

            <p>
                Every blood donation can save up to three lives. This system allows donors to register, patients to request blood, and administrators to manage donor and request records efficiently.
            </p>

            <div class="mt-4">

                <a asp-controller="Donor"
                   asp-action="Register"
                   class="btn btn-danger btn-lg me-2">

                    Become a Donor

                </a>

                <a asp-controller="Blood"
                   asp-action="Request"
                   class="btn btn-outline-danger btn-lg">

                    Request Blood

                </a>

            </div>

        </div>

        <div class="col-lg-6 text-center">

            <img src="https://images.unsplash.com/photo-1615461066841-6116e61058f4?w=700"
                 class="img-fluid rounded shadow"
                 alt="Blood Donation">

        </div>

    </div>

</div>

<hr>

<div class="container py-5">

    <h2 class="text-center text-danger fw-bold mb-5">
        Why Blood Donation Matters?
    </h2>

    <div class="row">

        <div class="col-md-3 mb-4">

            <div class="card shadow h-100 text-center p-4">

                <h1>❤️</h1>

                <h4 class="text-danger">
                    Save Lives
                </h4>

                <p>
                    One donation can help save multiple lives during emergencies.
                </p>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow h-100 text-center p-4">

                <h1>🩸</h1>

                <h4 class="text-danger">
                    Donate Blood
                </h4>

                <p>
                    Healthy people can donate blood every few months and help society.
                </p>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow h-100 text-center p-4">

                <h1>🏥</h1>

                <h4 class="text-danger">
                    Hospitals
                </h4>

                <p>
                    Hospitals receive blood quickly through registered donors.
                </p>

            </div>

        </div>

        <div class="col-md-3 mb-4">

            <div class="card shadow h-100 text-center p-4">

                <h1>🤝</h1>

                <h4 class="text-danger">
                    Community
                </h4>

                <p>
                    Build a stronger community by helping people in medical emergencies.
                </p>

            </div>

        </div>

    </div>

</div>

<hr>

<div class="container py-5">

    <h2 class="text-center text-danger fw-bold mb-5">
        Our Mission & Vision
    </h2>

    <div class="row">

        <div class="col-md-6 mb-4">

            <div class="card shadow p-4 h-100">

                <h3 class="text-danger">
                    🎯 Mission
                </h3>

                <p class="mt-3">
                    To encourage voluntary blood donation and provide blood quickly to patients by connecting donors and hospitals through a simple online platform.
                </p>

            </div>

        </div>

        <div class="col-md-6 mb-4">

            <div class="card shadow p-4 h-100">

                <h3 class="text-danger">
                    👁 Vision
                </h3>

                <p class="mt-3">
                    To become a trusted digital blood donation network that helps save lives and ensures blood is available whenever it is needed.
                </p>

            </div>

        </div>

    </div>

</div>

<div class="container mb-5">

    <div class="card bg-danger text-white text-center p-5">

        <h2>
            Be Someone's Lifeline ❤️
        </h2>

        <p class="mt-3 fs-5">
            Your single blood donation can make a life-changing difference.
            Join our Blood Donation System today.
        </p>

        <div class="mt-3">

            <a asp-controller="Donor"
               asp-action="Register"
               class="btn btn-light btn-lg text-danger fw-bold">

                Register Now

            </a>

        </div>

    </div>

</div>