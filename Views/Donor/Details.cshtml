@{
    ViewData["Title"] = "Donor Details";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="text-danger fw-bold">
            Donor Profile
        </h1>

        <p class="lead">
            Complete donor information
        </p>

    </div>


    <div class="card shadow-lg">

        <div class="card-header bg-danger text-white text-center">

            <h3>
                Donor Details
            </h3>

        </div>


        <div class="card-body p-5">


            <div class="row align-items-center">


                <!-- Profile Image -->

                <div class="col-md-4 text-center">

                    <div style="font-size:100px;">
                        👨
                    </div>

                    <h3 class="text-danger mt-3">
                        Rahul Sharma
                    </h3>


                    <span class="badge bg-success">
                        Available
                    </span>

                </div>



                <!-- Details -->

                <div class="col-md-8">


                    <div class="row">


                        <div class="col-md-6 mb-3">

                            <h6 class="text-danger">
                                Blood Group
                            </h6>

                            <p>
                                O+
                            </p>

                        </div>



                        <div class="col-md-6 mb-3">

                            <h6 class="text-danger">
                                Age
                            </h6>

                            <p>
                                25 Years
                            </p>

                        </div>



                        <div class="col-md-6 mb-3">

                            <h6 class="text-danger">
                                Gender
                            </h6>

                            <p>
                                Male
                            </p>

                        </div>



                        <div class="col-md-6 mb-3">

                            <h6 class="text-danger">
                                Mobile Number
                            </h6>

                            <p>
                                9876543210
                            </p>

                        </div>



                        <div class="col-md-6 mb-3">

                            <h6 class="text-danger">
                                Email
                            </h6>

                            <p>
                                rahul@gmail.com
                            </p>

                        </div>



                        <div class="col-md-6 mb-3">

                            <h6 class="text-danger">
                                City
                            </h6>

                            <p>
                                Jaipur
                            </p>

                        </div>



                        <div class="col-12 mb-3">

                            <h6 class="text-danger">
                                Address
                            </h6>

                            <p>
                                Jaipur, Rajasthan, India
                            </p>

                        </div>


                    </div>


                </div>


            </div>


            <hr>


            <div class="row text-center">


                <div class="col-md-4">

                    <h4 class="text-danger">
                        5+
                    </h4>

                    <p>
                        Donations Completed
                    </p>

                </div>



                <div class="col-md-4">

                    <h4 class="text-danger">
                        2026
                    </h4>

                    <p>
                        Registered Year
                    </p>

                </div>



                <div class="col-md-4">

                    <h4 class="text-danger">
                        O+
                    </h4>

                    <p>
                        Blood Type
                    </p>

                </div>


            </div>


        </div>


    </div>


</div>