@model BloodDonationSystem.Models.Donor

@{
    ViewData["Title"] = "Donor Details";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="text-danger fw-bold">
            Donor Profile
        </h1>

        <p class="lead">
            Complete donor information
        </p>

    </div>


    <div class="card shadow-lg">

        <div class="card-header bg-danger text-white text-center">

            <h3>
                Donor Details
            </h3>

        </div>


        <div class="card-body p-5">

            <div class="row align-items-center">


                <!-- Default Profile Icon -->

                <div class="col-md-4 text-center">

                    <div style="font-size:150px;">
                        👤
                    </div>


                    <h3 class="text-danger mt-3">

                        @Model.FullName

                    </h3>


                    <span class="badge bg-success">
                        Available
                    </span>


                </div>




                <!-- Donor Information -->

                <div class="col-md-8">

                    <div class="row">


                        <div class="col-md-6 mb-3">

                            <h6 class="text-danger">
                                Blood Group
                            </h6>

                            <p>
                                @Model.BloodGroup
                            </p>

                        </div>



                        <div class="col-md-6 mb-3">

                            <h6 class="text-danger">
                                Age
                            </h6>

                            <p>
                                @Model.Age Years
                            </p>

                        </div>



                        <div class="col-md-6 mb-3">

                            <h6 class="text-danger">
                                Gender
                            </h6>

                            <p>
                                @Model.Gender
                            </p>

                        </div>



                        <div class="col-md-6 mb-3">

                            <h6 class="text-danger">
                                Mobile Number
                            </h6>

                            <p>
                                @Model.Mobile
                            </p>

                        </div>



                        <div class="col-md-6 mb-3">

                            <h6 class="text-danger">
                                Email
                            </h6>

                            <p>
                                @Model.Email
                            </p>

                        </div>



                        <div class="col-md-6 mb-3">

                            <h6 class="text-danger">
                                City
                            </h6>

                            <p>
                                @Model.City
                            </p>

                        </div>



                        <div class="col-md-6 mb-3">

                            <h6 class="text-danger">
                                Last Donation Date
                            </h6>

                            <p>
                                @Model.LastDonationDate.ToString("dd-MM-yyyy")
                            </p>

                        </div>



                        <div class="col-12 mb-3">

                            <h6 class="text-danger">
                                Address
                            </h6>

                            <p>
                                @Model.Address
                            </p>

                        </div>


                    </div>

                </div>


            </div>


        </div>


    </div>


</div>