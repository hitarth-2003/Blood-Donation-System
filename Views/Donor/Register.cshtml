@model BloodDonationSystem.Models.Donor

@{
    ViewData["Title"] = "Become a Donor";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="text-danger fw-bold">
            Blood Donor Registration
        </h1>

        <p class="lead">
            Become a Hero. Donate Blood. Save Lives.
        </p>

    </div>


    <div class="card shadow-lg">

        <div class="card-header bg-danger text-white">

            <h3 class="mb-0">
                Donor Registration Form
            </h3>

        </div>


        <div class="card-body p-4">


            <form asp-action="Register" method="post">


                <div class="row">


                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Full Name
                        </label>

                        <input asp-for="FullName"
                               class="form-control"
                               placeholder="Enter Full Name">

                    </div>



                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Age
                        </label>

                        <input asp-for="Age"
                               class="form-control"
                               placeholder="Age">

                    </div>



                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Weight (kg)
                        </label>

                        <input class="form-control"
                               placeholder="Weight">

                    </div>



                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Gender
                        </label>

                        <select asp-for="Gender" class="form-select">

                            <option selected disabled>
                                Select Gender
                            </option>

                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>

                        </select>

                    </div>



                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Blood Group
                        </label>

                        <select asp-for="BloodGroup" class="form-select">

                            <option selected disabled>
                                Select Blood Group
                            </option>

                            <option>A+</option>
                            <option>A-</option>
                            <option>B+</option>
                            <option>B-</option>
                            <option>AB+</option>
                            <option>AB-</option>
                            <option>O+</option>
                            <option>O-</option>

                        </select>

                    </div>



                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Mobile Number
                        </label>

                        <input asp-for="Mobile"
                               class="form-control"
                               placeholder="Enter Mobile Number">

                    </div>



                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Email Address
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter Email">

                    </div>



                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            City
                        </label>

                        <input asp-for="City"
                               class="form-control"
                               placeholder="Enter City">

                    </div>



                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Last Donation Date
                        </label>

                        <input asp-for="LastDonationDate"
                               type="date"
                               class="form-control">

                    </div>



                    <div class="col-12 mb-3">

                        <label class="form-label">
                            Address
                        </label>

                        <textarea asp-for="Address"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter Complete Address"></textarea>

                    </div>


                </div>



                <div class="d-grid">

                    <button class="btn btn-danger btn-lg">

                        Register as Donor

                    </button>

                </div>


            </form>


        </div>

    </div>



    @if(TempData["Message"] != null)
{
    <div class="alert alert-success mt-4 text-center">

        <strong>
            Success!
        </strong>

        @TempData["Message"]

    </div>
}

</div>