@model IEnumerable<BloodDonationSystem.Models.Donor>

@{
    ViewData["Title"] = "Donor List";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="text-danger fw-bold">
            Available Blood Donors
        </h1>

        <p class="lead">
            Find people who are ready to donate blood and save lives.
        </p>

    </div>

    <div class="card shadow">

        <div class="card-header bg-danger text-white">

            <h4 class="mb-0">
                Donor Information
            </h4>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover text-center align-middle">

                    <thead class="table-danger">

                        <tr>

                            <th>Name</th>

                            <th>Blood Group</th>

                            <th>Gender</th>

                            <th>City</th>

                            <th>Mobile</th>

                            <th>Status</th>

                            <th width="250">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var donor in Model)
                        {
                            <tr>

                                <td>
                                    @donor.FullName
                                </td>

                                <td>

                                    <span class="badge bg-danger">

                                        @donor.BloodGroup

                                    </span>

                                </td>

                                <td>
                                    @donor.Gender
                                </td>

                                <td>
                                    @donor.City
                                </td>

                                <td>
                                    @donor.Mobile
                                </td>

                                <td>

                                    <span class="badge bg-success">

                                        Available

                                    </span>

                                </td>

                                <td>

                                    <a asp-controller="Donor"
                                       asp-action="Details"
                                       asp-route-id="@donor.Id"
                                       class="btn btn-info btn-sm">

                                        View

                                    </a>

                                    <a asp-controller="Donor"
                                       asp-action="Edit"
                                       asp-route-id="@donor.Id"
                                       class="btn btn-warning btn-sm">

                                        Edit

                                    </a>

                                    <a asp-controller="Donor"
                                       asp-action="Delete"
                                       asp-route-id="@donor.Id"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Are you sure you want to delete this donor?');">

                                        Delete

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>