@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="container mt-5">

    <div class="row align-items-center">

        <div class="col-md-6">

            <h1 class="display-4 fw-bold text-danger">
                Donate Blood,
                Save Lives ❤️
            </h1>

            <p class="lead mt-3">
                Every drop of blood can save someone's life.
                Join our Blood Donation System and become a hero today.
            </p>

            <a href="#" class="btn btn-danger btn-lg me-3">
                Become a Donor
            </a>

            <a href="#" class="btn btn-outline-danger btn-lg">
                Request Blood
            </a>

        </div>

        <div class="col-md-6 text-center">

            <img src="https://images.unsplash.com/photo-1615461066841-6116e61058f4?w=700"
                 class="img-fluid rounded shadow"
                 alt="Blood Donation">

        </div>

    </div>

</div>

<hr class="my-5">

<!-- Statistics -->
<div class="container">

    <h2 class="text-center text-danger mb-4">
        Blood Donation Statistics
    </h2>

    <div class="row text-center">

        <div class="col-md-3 mb-3">
            <div class="card shadow">
                <div class="card-body">
                    <h2 class="text-danger">250+</h2>
                    <p>Total Donors</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow">
                <div class="card-body">
                    <h2 class="text-danger">120</h2>
                    <p>Blood Requests</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow">
                <div class="card-body">
                    <h2 class="text-danger">85</h2>
                    <p>Units Available</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow">
                <div class="card-body">
                    <h2 class="text-danger">15</h2>
                    <p>Hospitals Connected</p>
                </div>
            </div>
        </div>

    </div>

</div>