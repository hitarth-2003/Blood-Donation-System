@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-5">

    <h1 class="text-center text-danger fw-bold mb-5">
        Contact Us
    </h1>

    <div class="row">

        <!-- Contact Information -->

        <div class="col-lg-5 mb-4">

            <div class="card shadow p-4 h-100">

                <h3 class="text-danger mb-4">
                    Contact Information
                </h3>

                <p>
                    <strong>📍 Address:</strong><br>
                    Parul University, Vadodara, Gujarat
                </p>

                <p>
                    <strong>📞 Phone:</strong><br>
                    +91 9876543210
                </p>

                <p>
                    <strong>📧 Email:</strong><br>
                    blooddonation@gmail.com
                </p>

                <p>
                    <strong>🕒 Office Hours:</strong><br>
                    Monday - Saturday<br>
                    9:00 AM - 6:00 PM
                </p>

                <hr>

                <h5 class="text-danger">
                    Follow Us
                </h5>

                <div class="mt-3">

                    <i class="fa-brands fa-facebook fa-2x text-primary me-3"></i>

                    <i class="fa-brands fa-instagram fa-2x text-danger me-3"></i>

                    <i class="fa-brands fa-twitter fa-2x text-info me-3"></i>

                    <i class="fa-brands fa-linkedin fa-2x text-primary"></i>

                </div>

            </div>

        </div>

        <!-- Contact Form -->

        <div class="col-lg-7">

            <div class="card shadow p-4">

                <h3 class="text-danger mb-4">
                    Send Message
                </h3>

                <form>

                    <div class="mb-3">

                        <label class="form-label">
                            Full Name
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Enter your name">

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Email
                        </label>

                        <input type="email"
                               class="form-control"
                               placeholder="Enter your email">

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Subject
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Subject">

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Message
                        </label>

                        <textarea class="form-control"
                                  rows="5"
                                  placeholder="Write your message"></textarea>

                    </div>

                    <button type="submit"
                            class="btn btn-danger btn-lg">

                        Send Message

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

<!-- Google Map -->

<div class="container mb-5">

    <div class="card shadow">

        <div class="card-body">

            <h3 class="text-danger text-center mb-4">
                Our Location
            </h3>

            <iframe
                src="https://www.google.com/maps?q=Parul+University+Vadodara&output=embed"
                width="100%"
                height="400"
                style="border:0;"
                allowfullscreen=""
                loading="lazy">

            </iframe>

        </div>

    </div>

</div>

<!-- Success Message (Hidden for now) -->

<div class="container mb-5">

    <div class="alert alert-success text-center">

        <strong>
            Thank You!
        </strong>

        We have received your message.
        We will reach you as soon as possible.

    </div>

</div>