@{
    ViewData["Title"] = "Contact";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="text-danger fw-bold">Contact Us</h1>
        <p class="lead">
            Have questions or need blood urgently? Get in touch with us.
        </p>
    </div>

    <div class="row">

        <!-- Contact Information -->
        <div class="col-lg-5">

            <div class="card shadow p-4 mb-4">

                <h3 class="text-danger mb-4">Contact Information</h3>

                <p>
                    <strong>📍 Address</strong><br />
                    Parul University,<br />
                    Vadodara, Gujarat
                </p>

                <hr />

                <p>
                    <strong>📞 Phone</strong><br />
                    +91 9876543210
                </p>

                <hr />

                <p>
                    <strong>📧 Email</strong><br />
                    blooddonation@gmail.com
                </p>

                <hr />

                <p>
                    <strong>🕒 Working Hours</strong><br />
                    Monday - Saturday<br />
                    9:00 AM - 6:00 PM
                </p>

            </div>

        </div>

        <!-- Contact Form -->
        <div class="col-lg-7">

            <div class="card shadow p-4">

                <h3 class="text-danger mb-4">Send us a Message</h3>

                <form>

                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input type="text" class="form-control" placeholder="Enter your name">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" placeholder="Enter your email">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Subject</label>
                        <input type="text" class="form-control" placeholder="Enter subject">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Message</label>
                        <textarea class="form-control" rows="5" placeholder="Write your message"></textarea>
                    </div>

                    <button class="btn btn-danger w-100">
                        Send Message
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>