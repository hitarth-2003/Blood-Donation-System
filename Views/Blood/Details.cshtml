@model BloodDonationSystem.Models.BloodRequest

@{
    ViewData["Title"] = "Blood Request Details";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="text-danger fw-bold">
            Blood Request Details
        </h1>

        <p class="lead">
            Complete patient blood request information
        </p>
    </div>

    <div class="card shadow-lg">

        <div class="card-header bg-danger text-white text-center">
            <h3>Patient Details</h3>
        </div>

        <div class="card-body p-5">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <h6 class="text-danger">Patient Name</h6>
                    <p>@Model.PatientName</p>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-danger">Age</h6>
                    <p>@Model.Age Years</p>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-danger">Gender</h6>
                    <p>@Model.Gender</p>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-danger">Blood Group</h6>
                    <p>
                        <span class="badge bg-danger">
                            @Model.BloodGroup
                        </span>
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-danger">Units Required</h6>
                    <p>@Model.UnitsRequired Unit(s)</p>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-danger">Required Date</h6>
                    <p>@Model.RequiredDate.ToString("dd-MM-yyyy")</p>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-danger">Hospital Name</h6>
                    <p>@Model.HospitalName</p>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-danger">City</h6>
                    <p>@Model.City</p>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-danger">Contact Number</h6>
                    <p>@Model.ContactNumber</p>
                </div>

                <div class="col-md-6 mb-3">
                    <h6 class="text-danger">Priority</h6>

                    @if (Model.Priority == "Critical")
                    {
                        <span class="badge bg-danger">@Model.Priority</span>
                    }
                    else if (Model.Priority == "Urgent")
                    {
                        <span class="badge bg-warning text-dark">@Model.Priority</span>
                    }
                    else
                    {
                        <span class="badge bg-primary">@Model.Priority</span>
                    }

                </div>

                <div class="col-12 mb-3">
                    <h6 class="text-danger">Hospital Address</h6>
                    <p>@Model.Address</p>
                </div>

            </div>

            <hr />

            <div class="text-center">

                <a asp-action="Requests"
                   class="btn btn-secondary">
                    Back
                </a>

            </div>

        </div>

    </div>

</div>