@model IEnumerable<BloodDonationSystem.Models.BloodRequest>

@{
    ViewData["Title"] = "Blood Requests";
}

<div class="container py-5">

    <div class="text-center mb-4">

        <h1 class="text-danger fw-bold">
            Blood Requests
        </h1>

        <p class="lead">
            Current blood requests submitted by patients.
        </p>

    </div>

    <div class="card shadow">

        <div class="card-header bg-danger text-white">

            <h4 class="mb-0">
                Request List
            </h4>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover text-center align-middle">

                    <thead class="table-danger">

                        <tr>

                            <th>Patient</th>
                            <th>Blood Group</th>
                            <th>Hospital</th>
                            <th>City</th>
                            <th>Units</th>
                            <th>Priority</th>
                            <th width="260">Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var request in Model)
                        {

                            <tr>

                                <td>
                                    @request.PatientName
                                </td>

                                <td>

                                    <span class="badge bg-danger">

                                        @request.BloodGroup

                                    </span>

                                </td>

                                <td>
                                    @request.HospitalName
                                </td>

                                <td>
                                    @request.City
                                </td>

                                <td>
                                    @request.UnitsRequired
                                </td>

                                <td>

                                    @if (request.Priority == "Critical")
                                    {
                                        <span class="badge bg-danger">
                                            Critical
                                        </span>
                                    }
                                    else if (request.Priority == "Urgent")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Urgent
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">
                                            Normal
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-controller="Blood"
                                       asp-action="Details"
                                       asp-route-id="@request.Id"
                                       class="btn btn-info btn-sm">

                                        View

                                    </a>

                                    <a asp-controller="Blood"
                                       asp-action="Edit"
                                       asp-route-id="@request.Id"
                                       class="btn btn-warning btn-sm">

                                        Edit

                                    </a>

                                    <a asp-controller="Blood"
                                       asp-action="Delete"
                                       asp-route-id="@request.Id"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Are you sure you want to delete this request?');">

                                        Delete

                                    </a>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>