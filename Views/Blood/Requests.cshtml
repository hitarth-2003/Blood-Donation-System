@{
    ViewData["Title"] = "Blood Requests";
}

<div class="container py-5">

    <div class="text-center mb-4">

        <h1 class="text-danger fw-bold">
            Blood Requests
        </h1>

        <p class="lead">
            Current blood requests submitted by patients.
        </p>

    </div>

    <div class="card shadow">

        <div class="card-header bg-danger text-white">

            <h4 class="mb-0">
                Request List
            </h4>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover text-center align-middle">

                    <thead class="table-danger">

                        <tr>

                            <th>Patient</th>

                            <th>Blood Group</th>

                            <th>Hospital</th>

                            <th>City</th>

                            <th>Units</th>

                            <th>Priority</th>

                            <th>Status</th>

                        </tr>

                    </thead>

                    <tbody>

                        <tr>

                            <td>Rahul Sharma</td>

                            <td><span class="badge bg-danger">O+</span></td>

                            <td>City Hospital</td>

                            <td>Jaipur</td>

                            <td>2</td>

                            <td><span class="badge bg-warning text-dark">Urgent</span></td>

                            <td><span class="badge bg-success">Pending</span></td>

                        </tr>

                        <tr>

                            <td>Priya Patel</td>

                            <td><span class="badge bg-danger">A+</span></td>

                            <td>Apollo Hospital</td>

                            <td>Vadodara</td>

                            <td>1</td>

                            <td><span class="badge bg-danger">Critical</span></td>

                            <td><span class="badge bg-success">Pending</span></td>

                        </tr>

                        <tr>

                            <td>Amit Singh</td>

                            <td><span class="badge bg-danger">B+</span></td>

                            <td>SMS Hospital</td>

                            <td>Kota</td>

                            <td>3</td>

                            <td><span class="badge bg-primary">Normal</span></td>

                            <td><span class="badge bg-success">Approved</span></td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>