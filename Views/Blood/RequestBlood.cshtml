@model BloodDonationSystem.Models.BloodRequest

@{
    ViewData["Title"] = "Request Blood";
}

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="text-danger fw-bold">
            Request Blood
        </h1>

        <p class="lead">
            Submit your blood requirement and get help quickly.
        </p>

    </div>

    <div class="card shadow-lg">

        <div class="card-header bg-danger text-white">

            <h3 class="mb-0">
                Blood Request Form
            </h3>

        </div>

        <div class="card-body p-4">

            <form asp-action="RequestBlood" method="post">

                <div class="row">

                    @* <div class="col-md-6 mb-3"> *@
                      <div asp-validation-summary="All" class="text-danger">

                        <label class="form-label">
                            Patient Name
                        </label>

                        <input asp-for="PatientName"
                               class="form-control"
                               placeholder="Enter Patient Name">

                    </div>

                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Age
                        </label>

                        <input asp-for="Age"
                               class="form-control"
                               placeholder="Age">

                    </div>

                    <div class="col-md-3 mb-3">

                        <label class="form-label">
                            Gender
                        </label>

                        <select asp-for="Gender" class="form-select">

                            <option selected disabled>Select Gender</option>

                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Required Blood Group
                        </label>

                        <select asp-for="BloodGroup" class="form-select">

                            <option selected disabled>Select Blood Group</option>

                            <option>A+</option>
                            <option>A-</option>
                            <option>B+</option>
                            <option>B-</option>
                            <option>AB+</option>
                            <option>AB-</option>
                            <option>O+</option>
                            <option>O-</option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Units Required
                        </label>

                        <input asp-for="UnitsRequired"
                               class="form-control"
                               placeholder="Number of Units">

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Hospital Name
                        </label>

                        <input asp-for="HospitalName"
                               class="form-control"
                               placeholder="Enter Hospital Name">

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            City
                        </label>

                        <input asp-for="City"
                               class="form-control"
                               placeholder="Enter City">

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Contact Number
                        </label>

                        <input asp-for="ContactNumber"
                               class="form-control"
                               placeholder="Enter Contact Number">

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Required Date
                        </label>

                        <input asp-for="RequiredDate"
                               type="date"
                               class="form-control">

                    </div>

                    <div class="col-md-12 mb-3">

                        <label class="form-label">
                            Emergency Priority
                        </label>

                        <select asp-for="Priority" class="form-select">

                            <option>Normal</option>
                            <option>Urgent</option>
                            <option>Critical</option>

                        </select>

                    </div>

                    <div class="col-12 mb-3">

                        <label class="form-label">
                            Hospital Address
                        </label>

                        <textarea asp-for="Address"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter Complete Address"></textarea>

                    </div>

                </div>

                <div class="d-grid">

                    <button class="btn btn-danger btn-lg">

                        Submit Blood Request

                    </button>

                </div>

            </form>

        </div>

    </div>

    @if (TempData["Message"] != null)
{
    <div class="alert alert-success mt-4 text-center">
        <strong>Success!</strong>
        @TempData["Message"]
    </div>
}

</div>